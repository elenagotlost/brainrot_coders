[Unit]
Description=Math on the Edge: code model, Qwen2.5-Math-1.5B-Instruct (llama.cpp, port 8091)
After=local-fs.target

[Service]
Type=simple
User=arduino
ExecStart=/home/arduino/llama.cpp/build/bin/llama-server -m /home/arduino/models/Qwen2.5-Math-1.5B-Instruct-Q4_K_M.gguf --host 127.0.0.1 --port 8091 --threads 4 --ctx-size 4096 --parallel 1 --cache-ram 0 --ctx-checkpoints 2 --jinja --reasoning off --reasoning-budget 0 --alias qwen2.5-math-1.5b
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
