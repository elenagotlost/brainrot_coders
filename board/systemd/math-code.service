[Unit]
Description=Math on the Edge: code model, Qwen2.5-Coder 1.5B (llama.cpp, port 8091)
After=local-fs.target

[Service]
Type=simple
User=arduino
ExecStart=/home/arduino/llama.cpp/build/bin/llama-server -m /home/arduino/models/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf --host 127.0.0.1 --port 8091 --threads 4 --ctx-size 4096 --parallel 1 --cache-ram 0 --jinja --alias qwen2.5-coder-1.5b
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
